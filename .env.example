# Bu dosyayı .env.local adıyla kopyalayıp anahtarını yaz.
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=buraya_anahtarini_yaz
# Sırayla denenir: biri kota/yoğunluk yerse diğerine geçer.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# YOLO servisinin adresi (Hugging Face Space). Boş bırakılırsa sadece Gemini çalışır.
YOLO_URL=
