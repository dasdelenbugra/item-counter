# Copy this file to .env.local and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Uncomment to change a default.

# Comma-separated models, tried in order when one hits its quota or is busy.
# GEMINI_MODEL=
# LOW / MEDIUM / HIGH (default). Lower is faster but mixes up similar brands.
# GEMINI_THINKING=
# MEDIUM / HIGH / ULTRA_HIGH (default).
# GEMINI_COZUNURLUK=
# Time limit for the Gemini call in ms (default 54000). Keep it under 60000 on Vercel.
# GEMINI_ZAMAN_ASIMI_MS=
# Tries per visitor per day on the live site (default 3, 0 = no limit).
# GUNLUK_DENEME_SINIRI=
